# Nvox configuration example.
# Copy to ./nvox.toml or ~/.config/nvox/nvox.toml and edit as needed.
# Every section is optional.

[scan]
# Maximum artifact-graph depth (chains such as LSB -> zlib -> base64 -> flag).
max_depth = 4
# Per-plugin wall-clock timeout in seconds.
timeout = 120
# Largest artifact Nvox will materialise (bytes).
max_artifact_bytes = 67108864
# Worker threads; 0 means one per CPU.
jobs = 0

[flags]
# Flag formats. "{}" is the only placeholder and matches the flag body.
formats = ["ctf{}"]

[plugins]
# Extra plugin directories, relative to this file or absolute.
dirs = ["plugins", "~/.config/nvox/plugins"]
# Plugin names that must never run.
disable = []

# Per-plugin option overrides. Defaults are declared by the plugin.
# [plugins.options."generic.strings"]
# min_length = 6
# utf16 = false

# Bound the XOR brute-force decoder. Inputs larger than max_input_bytes are
# skipped; max_candidates caps emitted text artifacts per invocation.
# [plugins.options."decoder.xor"]
# max_input_bytes = 16384
# max_candidates = 5
# min_printable = 0.75

# Limit PNG LSB extraction on large images.
# [plugins.options."image.lsb"]
# max_pixels = 2000000
# channels = "all"   # or a channel list/CSV, e.g. "1" or [0, 1, 2]

# Optional external bridge options. Each bridge is skipped when its binary is
# missing; stegseek additionally needs a wordlist to run.
# [plugins.options."bridge.stegseek"]
# wordlist = "/usr/share/wordlists/rockyou.txt"
# [plugins.options."bridge.steghide"]
# passphrase = ""
# [plugins.options."bridge.outguess"]
# key = ""
# [plugins.options."bridge.binwalk"]
# extract = false
# [plugins.options."bridge.tesseract"]
# lang = "eng"
# psm = 6
# [plugins.options."bridge.stegsolve"]
# jar = "/opt/Stegsolve.jar"
# command = ["/path/to/headless-stegsolve", "{input}", "{outdir}"]

# Declarative command plugins can set their own sandbox limits in their own
# plugin .toml file (not in nvox.toml), for example:
# [plugin.sandbox]
# timeout = 60
# max_output_bytes = 1048576
# max_file_bytes = 16777216
# max_files = 1000
# max_total_bytes = 67108864
# inherit_env = false
# env = { TESSDATA_PREFIX = "/custom/tessdata" }

[tools]
# External tools that should never be invoked.
disable = []
# disable = ["steghide"]
